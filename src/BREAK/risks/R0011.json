{
  "R0011": {
    "title": "账号倒卖",
    "definition": "账号倒卖是指个体或组织通过非法手段获取大量互联网平台账号，然后以出售为目的进行交易的行为。",
    "description": "这些账号可以是社交媒体、电子邮件、在线游戏、电商等各类互联网服务的账户。账号倒卖者通常通过多种途径获取这些账号，包括但不限于非法黑客手段、恶意软件攻击、社会工程学等。一旦获得账号后，他们会在暗网或特定的网络论坛上出售给有需求的买家。",
    "complexity": "intermediate",
    "influence": "影响平台正常运营秩序。对用户隐私安全构成威胁，也可能导致账户被滥用、信息泄露、身份盗窃等问题",
    "avoidances": [
      "A0007",
      "A0024",
      "A0015",
      "A0023-001",
      "A0020"
    ],
    "references": [
      {
        "title": "Valid Accounts - MITRE ATT&CK T1078",
        "link": "https://attack.mitre.org/techniques/T1078/"
      }
    ],
    "updated": "2026-07-03",
    "keywords": [
      "账号倒卖",
      "账号买卖",
      "账号交易",
      "号商",
      "卖号",
      "成品号",
      "账号黑市"
    ],
    "riskAssessment": {
      "likelihood": "high",
      "businessLoss": "high",
      "attackCost": "low",
      "detectionDifficulty": "medium",
      "defenseMaturity": "low",
      "observables": [
        "大量账号在注册后短期内集中登录异常 IP 或设备，呈现批量转手特征",
        "账号登录地理位置、设备指纹发生跨地区跳跃，与历史使用习惯不符",
        "暗网或发卡平台出现平台账号批量上架售卖商品",
        "被倒卖账号在转手后行为模式突变，出现批量自动化操作或权益套现"
