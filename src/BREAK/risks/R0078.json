        "relation": "co-occurrence",
        "note": "数据泄露与软件供应链风险在定义或描述中互相指向。"
      },
      {
        "key": "R0081-002",
        "relation": "co-occurrence",
        "note": "数据泄露与硬件供应链风险在定义或描述中互相指向。"
      },
      {
        "key": "R0081-003",
        "relation": "co-occurrence",
        "note": "数据泄露与云服务供应链风险在定义或描述中互相指向。"
      },
      {
        "key": "R0081-004",
        "relation": "co-occurrence",
        "note": "数据泄露与外包人员风险在定义或描述中互相指向。"
      },
