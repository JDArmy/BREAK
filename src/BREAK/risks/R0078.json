{
  "R0078": {
    "title": "数据泄露",
    "definition": "数据泄露（data breach）风险是指组织或个人的敏感、机密或个人身份信息在未经授权的情况下被泄露、暴露或访问的潜在威胁。",
    "description": "可能发生在多种场景，包括网络攻击、内部泄露、物理设备丢失或被盗等。",
    "complexity": "basic",
    "influence": "危害包括隐私侵犯、经济损失、法律责任和声誉损害，对组织和个人都可能带来严重影响。",
    "avoidances": [
      "A0050",
      "A0054"
    ],
    "references": [
      {
        "title": "Data breach - Wikipedia",
        "link": "https://en.wikipedia.org/wiki/Data_breach"
      }
    ],
    "updated": "2026-06-11",
    "keywords": [
      "数据泄露",
      "数据外泄",
      "信息泄露",
      "数据泄漏",
      "敏感数据泄露",
      "数据库泄露",
      "Data breach"
    ],
    "relatedRisks": [
