# pre-commit: 刷新首页实体计数（src/BREAK/home.ts），若有变化则纳入本次提交
# 防止首页统计数字与实际数据脱节；失败则阻断提交
output=$(node scripts/validate/generate-home-counts.mjs 2>&1)
status=$?
if [ $status -ne 0 ]; then
  echo "❌ generate-home-counts 失败，提交中止："
  echo "$output"
  exit $status
fi
# home.ts 若被刷新则加入本次提交
git diff --quiet -- src/BREAK/home.ts || git add src/BREAK/home.ts

# major/minor 版本变化时，在本地 commit 前运行慢速浏览器回归和 Lighthouse；
# patch 版本跳过，避免日常数据修补提交被拖慢。
npm run precommit:browser-regression

# LLM 变更评审：默认开启，跑 review:changed 对本次变更实体做 B 类 subagent 交叉判断 + C 类 LLM 评审
# fail 阻断提交。设 BREAK_REVIEW_ON_COMMIT=0 可临时跳过（如纯文档/脚本改动不涉及实体）
# 存量已评实体通过指纹基线（scripts/validate/review-progress-baseline.json）自动跳过，不重复跑
if [ "$BREAK_REVIEW_ON_COMMIT" != "0" ]; then
  # 仅当有实体文件变更时才跑（避免纯脚本/文档提交被拖慢）
  if git diff --cached --name-only -- src/BREAK/ | grep -q '\.json$'; then
    echo "🔍 运行 review:changed（变更实体 LLM 评审，fail 阻断）..."
    node scripts/validate/review-changed.mjs --staged-only
    status=$?
    if [ $status -ne 0 ]; then
      echo "❌ review:changed 检出 fail，提交中止"
      echo "设 BREAK_REVIEW_ON_COMMIT=0 可跳过（但建议先修），review 级问题不阻断"
      exit $status
    fi
  fi
fi
