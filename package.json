{
  "name": "break",
  "version": "2.25.17",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run type-check && npm run validate:data && npm run test && npm run test:coverage && npm run validate:schema-docs && npm run validate:home-counts && npm run export:data && npm run export:data-en && npm run export:stix && npm run export:jsonld && npm run build-only && npm run export:data-package && npm run audit:bundle:check && npm run validate:data-export && npm run validate:data-package && npm run validate:stix",
    "build:validate": "npm run lint && npm run type-check && npm run validate:data && npm run test:coverage",
    "build:fast": "npm run type-check && npm run validate:data && npm run export:data && npm run export:data-en && npm run export:stix && npm run export:jsonld && npm run build-only && npm run export:data-package",
    "deploy:build": "npm run export:data && npm run export:data-en && npm run export:stix && npm run export:jsonld && npm run build-only && npm run export:data-package",
    "preview": "vite preview",
    "build-only": "vite build",
    "analyze": "ANALYZE=1 vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:data": "node scripts/validate/schema.mjs && node scripts/validate/i18n-sync.mjs --strict && node scripts/validate/english-i18n-quality.mjs && node scripts/validate/keywords.mjs && node scripts/validate/check-entity-relations.mjs && node scripts/validate/relations.mjs --strict && node scripts/validate/business-scenes.mjs && node scripts/validate/require-references.mjs && node scripts/validate/docs-consistency.mjs",
    "validate:data-export": "node scripts/validate/static-data-export.mjs",
    "validate:data-package": "node scripts/validate/data-package.mjs",
    "validate:schema-docs": "node scripts/validate/schema-docs.mjs",
    "schema:docs:write": "node scripts/validate/schema-docs.mjs --write",
    "validate:home-counts": "node scripts/validate/generate-home-counts.mjs --check",
    "generate:home-counts": "node scripts/validate/generate-home-counts.mjs",
    "export:data": "node scripts/validate/export-static-data.mjs",
    "export:data-en": "node scripts/skill/export_en_data.mjs",
    "export:data-package": "node scripts/validate/export-data-package.mjs",
    "export:stix": "node scripts/validate/export-stix.mjs",
    "export:jsonld": "node scripts/validate/export-jsonld.mjs",
    "validate:stix": "node scripts/validate/validate-stix.mjs",
    "version:bump": "node scripts/validate/auto-version.mjs",
    "test:smoke": "node scripts/validate/site-smoke.mjs",
    "test:performance": "node scripts/validate/site-performance.mjs",
    "test:visual-review": "node scripts/validate/site-visual-review.mjs",
    "test:relation-stability": "node scripts/validate/relation-stability.mjs",
    "test:lighthouse": "node scripts/validate/lighthouse-baseline.mjs",
    "ci:browser-regression-gate": "node scripts/validate/browser-regression-gate.mjs",
    "precommit:browser-regression": "node scripts/validate/precommit-browser-regression.mjs",
    "audit:keywords": "node scripts/validate/keywords.mjs",
    "fix:keywords": "node scripts/validate/keywords.mjs",
    "list:keyword-batches": "node scripts/validate/keyword-batches.mjs",
    "sync:lateral-relations": "node scripts/validate/sync-lateral-relations.mjs",
    "audit:relations": "node scripts/validate/relations.mjs",
    "audit:references": "node scripts/validate/references.mjs",
    "audit:references-health": "node scripts/validate/references-health.mjs",
    "audit:references-health:cached": "node scripts/validate/references-health.mjs --from-cache",
    "audit:references-browser": "node scripts/validate/check-403-with-browser.mjs",
    "audit:reference-domain-plan": "node scripts/validate/reference-domain-plan.mjs",
    "audit:content-quality": "node scripts/validate/content-quality.mjs",
    "audit:case-source-quality": "node scripts/validate/case-source-quality.mjs",
    "audit:quality-report": "node scripts/validate/quality-report.mjs",
    "audit:metrics": "node scripts/validate/metrics.mjs",
    "audit:bundle": "node scripts/validate/bundle-budget.mjs",
    "audit:lighthouse-sankey": "node scripts/validate/lighthouse-sankey-trace.mjs",
    "audit:bundle:check": "node scripts/validate/bundle-budget.mjs --check-only",
    "audit:maintenance": "npm run audit:references && npm run audit:relations && npm run audit:metrics && node scripts/validate/bundle-budget.mjs --no-fail && npm run audit:lighthouse-sankey && node scripts/validate/maintenance.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "import:cases": "node scripts/research/import-cases.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.9.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.10.0",
    "fuse.js": "^7.4.2",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "jsonld": "^9.0.0",
    "lighthouse": "^12.6.1",
    "playwright": "^1.61.0",
    "prettier": "^3.5.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "terser": "^5.39.0",
    "typescript": "^5.8.0",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.1.10"
  }
}
